---
import SiteMenu from "../components/SiteMenu.astro";

interface Props {
  title: string;
  description: string;
  bodyClass: string;
  current?: string;
}

const { title, description, bodyClass, current = "" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <title>{title}</title>
  <link rel="stylesheet" href="css/fonts.css">
  <link rel="stylesheet" href="css/styles.css">
</head>
<body class={bodyClass}>
  <main class="page__content">
    <slot />
  </main>

  <SiteMenu current={current} />

  <script is:inline src="js/main.js"></script>
</body>
</html>

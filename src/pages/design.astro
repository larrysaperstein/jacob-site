---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Design Samples — Jacob Bellotti"
  description="Design samples by Jacob Bellotti."
  bodyClass="page page--design"
  current="design"
>
    <section class="design" aria-labelledby="design-title">
      <h1 class="design__title" id="design-title">Design Samples</h1>
      <div class="design-grid">
        <div class="design-grid__row">
          <a
            class="design-grid__item design-grid__item--landscape design-grid__item--ogs"
            href="https://drive.google.com/file/d/1V6XcYaOxsRXtkW-D77PfO6K1lFySrfTX/view"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="OG’s of 901210"
          >
            <img src="assets/images/design/ogs.webp" alt="OG’s of 901210 design sample" loading="lazy">
          </a>
          <a
            class="design-grid__item design-grid__item--portrait design-grid__item--snob"
            href="https://drive.google.com/file/d/1LQaEmlBsLOFQlpOeAi03WCkXgU6wCyQG/view"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="High Snobiety"
          >
            <img src="assets/images/design/snob.webp" alt="High Snobiety design sample" loading="lazy">
          </a>
        </div>

        <div class="design-grid__row">
          <a
            class="design-grid__item design-grid__item--portrait design-grid__item--slaycation"
            href="https://drive.google.com/file/d/1d5-25ixMY6F3qxSI39HT68PJ0iog7cRo/view"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Slaycation"
          >
            <img src="assets/images/design/slaycation-design.webp" alt="Slaycation design sample" loading="lazy">
          </a>
          <a
            class="design-grid__item design-grid__item--landscape design-grid__item--cumming"
            href="https://drive.google.com/file/d/1V54P0yP5wxDjpgQJiGLGkj540Rx21mTL/view"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Club Cumming"
          >
            <img src="assets/images/design/cumming.webp" alt="Club Cumming design sample" loading="lazy">
          </a>
        </div>

        <div class="design-grid__row">
          <a
            class="design-grid__item design-grid__item--landscape design-grid__item--comedy"
            href="https://drive.google.com/file/d/1W2Z_YplcnG1066VAjT17co2oNbzld4g0/view"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Comedy Gold"
          >
            <img src="assets/images/design/comedygold.webp" alt="Comedy Gold design sample" loading="lazy">
          </a>
          <a
            class="design-grid__item design-grid__item--portrait design-grid__item--tracy"
            href="https://drive.google.com/file/d/10DY4CqCh-N-Z3K9-lL3V1hC5EyF4kpBn/view"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Tracy Takes Texas"
          >
            <img src="assets/images/design/traceytexas.webp" alt="Tracy Takes Texas design sample" loading="lazy">
          </a>
        </div>
      </div>
    </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Contact — Jacob Bellotti"
  description="Contact Jacob Bellotti."
  bodyClass="page page--contact"
  current="contact"
>
    <section class="contact" aria-labelledby="contact-title">
      <h1 class="contact__title" id="contact-title">Contact</h1>
      <p class="contact__intro">Thanks for getting in touch! Please fill out this contact form and I'll get back to you as soon as possible.</p>

      <form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="c62ea38a-d4af-4d42-9de5-fd75939b5c61">
        <input type="hidden" name="subject" value="New Contact Form Submission — Jacob Bellotti">
        <input type="hidden" name="from_name" value="Jacob Bellotti Website">
        <input type="checkbox" name="botcheck" class="contact-form__honeypot" tabindex="-1" autocomplete="off">

        <div class="contact-form__fields">
          <div class="contact-form__group">
            <label for="name" class="contact-form__label">Name</label>
            <input id="name" name="name" class="contact-form__input" placeholder="Your name" type="text" required>
          </div>
          <div class="contact-form__group">
            <label for="email" class="contact-form__label">Email</label>
            <input id="email" name="email" class="contact-form__input" placeholder="Your email" type="email" required>
          </div>
          <div class="contact-form__group">
            <label for="phone" class="contact-form__label">Phone</label>
            <input id="phone" name="phone" class="contact-form__input" placeholder="+1 (234) 567-8900" type="tel">
          </div>
          <div class="contact-form__group">
            <label for="message" class="contact-form__label">Message</label>
            <textarea id="message" name="message" class="contact-form__textarea" placeholder="Your message" required></textarea>
          </div>
        </div>

        <button class="contact-form__submit" type="submit">Send Message</button>
      </form>
    </section>
</BaseLayout>

              <img src="/assets/images/design/ogs.webp" alt="Design sample for The OG’s of 90210" loading="lazy">
            </a>
            <a
              class="design-grid__item design-grid__item--portrait design-grid__item--snob"
              href="https://drive.google.com/file/d/1LQaEmlBsLOFQlpOeAi03WCkXgU6wCyQG/view"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="High Snobiety"
            >
              <img src="/assets/images/design/snob.webp" alt="High Snobiety poster design by Jacob Bellotti" loading="lazy">
            </a>
          </div>

          <div class="design-grid__row">
            <a
              class="design-grid__item design-grid__item--portrait design-grid__item--slaycation"
              href="https://drive.google.com/file/d/1d5-25ixMY6F3qxSI39HT68PJ0iog7cRo/view"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Slaycation"
            >
              <img src="/assets/images/design/slaycation-design.webp" alt="Slaycation poster design by Jacob Bellotti" loading="lazy">
            </a>
            <a
              class="design-grid__item design-grid__item--landscape design-grid__item--cumming"
              href="https://drive.google.com/file/d/1V54P0yP5wxDjpgQJiGLGkj540Rx21mTL/view"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Club Cumming"
            >
              <img src="/assets/images/design/cumming.webp" alt="Club Cumming design by Jacob Bellotti" loading="lazy">
            </a>
          </div>

          <div class="design-grid__row">
            <a
              class="design-grid__item design-grid__item--landscape design-grid__item--comedy"
              href="https://drive.google.com/file/d/1W2Z_YplcnG1066VAjT17co2oNbzld4g0/view"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Comedy Gold"
            >
              <img src="/assets/images/design/comedygold.webp" alt="Comedy Gold design by Jacob Bellotti" loading="lazy">
            </a>
            <a
              class="design-grid__item design-grid__item--portrait design-grid__item--tracy"
              href="https://drive.google.com/file/d/10DY4CqCh-N-Z3K9-lL3V1hC5EyF4kpBn/view"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Tracy Takes Texas"
            >
              <img src="/assets/images/design/traceytexas.webp" alt="Tracy Takes Texas poster design by Jacob Bellotti" loading="lazy">
            </a>
          </div>
        </div>
      </section>
    </section>

    <section class="site-section" id="voiceover" aria-label="Voiceover">
      <article class="voiceover">
        <h1 class="voiceover__title">Voiceover</h1>

        <div class="voiceover__media">
          <div class="voiceover__embed">
            <iframe
              width="100%"
              height="166"
              scrolling="no"
              frameborder="no"
              allow="autoplay; encrypted-media"
              loading="lazy"
              title="Jacob Bellotti VO Demo Reel"
              src="https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/soundcloud%253Atracks%253A1925055632&color=%232b075f&auto_play=false&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true"
            ></iframe>
          </div>
          <p class="voiceover__credit">
            <a href="https://soundcloud.com/jacob-bellotti" target="_blank" rel="noopener noreferrer">Jacob Bellotti</a>
            <span aria-hidden="true"> · </span>
            <a href="https://soundcloud.com/jacob-bellotti/jacob-bellotti-vo-demo-reel" target="_blank" rel="noopener noreferrer">Jacob Bellotti VO Demo Reel</a>
          </p>
        </div>

        <div class="voiceover__copy">
          <p>Jacob is an experienced Voice Over Artist, with credits including scratch tracks for Nintendo’s The Legend of Zelda: Breath of the Wild, and instructional videos for GOW-MAC Industries.</p>
          <p>His work on radio liners earned him multiple nominations for Mercury Voice Awards in NYC.</p>
        </div>
      </article>
    </section>

    <section class="site-section" id="podcast" aria-label="Podcast">
      <article class="podcast">
        <h1 class="podcast__title">Let’s Talk About That!</h1>

        <div class="podcast__media">
          <div class="podcast__embed podcast__embed--spotify">
            <iframe
              data-testid="embed-iframe"
              src="https://open.spotify.com/embed/show/0dHnGMkv899UP9YwhStWJ6?utm_source=generator"
              title="Let’s Talk About That! on Spotify"
              width="100%"
              height="160"
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              allowfullscreen
              loading="lazy"
              style="border-radius: 12px; background: transparent;"
            ></iframe>
          </div>

          <div class="podcast__embed podcast__embed--youtube">
            <iframe
              src="https://www.youtube.com/embed/videoseries?si=FPmaB0bz-vfPVmHs&amp;list=PLz9S7lF5IHvNa7KSxQaORBrh5BTc3pGpO"
              title="Let’s Talk About That! YouTube playlist"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
        </div>

        <nav class="podcast__social" aria-label="Podcast social links">
          <a
            class="podcast__social-link"
            href="https://www.instagram.com/letstalkaboutthatpod"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
          >

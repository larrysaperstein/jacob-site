---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Jacob Bellotti — Writer, Producer, Designer & Voiceover Artist"
  description="Award-winning creative writer, producer, designer, voiceover talent, and performer based in Los Angeles. Explore Jacob Bellotti’s television, design, and voiceover work."
  bodyClass="page page--home"
  current=""
  ogType="profile"
>
    <section class="site-section" id="home" aria-label="Home">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero__text">
          <h1 class="hero__title" id="hero-title">Jacob Bellotti</h1>
          <p class="hero__bio">I'm an award-winning creative writer, producer, designer, voiceover talent, and performer in Los Angeles.</p>
        </div>
        <div class="hero__image-wrap">
          <picture>
            <source media="(max-width: 700px)" srcset="/assets/images/jacob-hero-vertical.webp">
            <img
              class="hero__image"
              src="/assets/images/jacob-hero.webp"
              alt="Jacob Bellotti smiling, wearing glasses and a burgundy shirt"
              width="2133"
              height="1378"
            >
          </picture>
        </div>
      </section>
    </section>

    <section class="site-section" id="about" aria-label="About">
      <article class="about">
        <div class="about__layout">
          <div class="about__left">
            <h1 class="about__headline">LA Heart. NJ Flair.</h1>

            <div class="about__text">
              <p>Jacob Bellotti is a creative producer and writer in Los Angeles, who has created hit shows for television and written for the EMMY-Winning “RuPaul’s Drag Race.”</p>

              <p>In television, Jacob has created shows like “Owning Manhattan” for Netflix, Crave TV’s “Slaycation!”, and “Bring Back My Girls” for WOWPresentsPlus. He wrote sketches featured on the 28-EMMY winning “RuPaul’s Drag Race” and created challenges for the show. He has produced shows like "American Gladiators" for Prime Video, "Schooled!" for Netflix, and "Citizen Detective" for Sundance.</p>

              <p>Spending 4 years in creative development at World of Wonder Productions, Jacob has also consulted for Hi Mom Productions, worked in talent relations on “America’s Most Wanted” for FOX, and was a talent assistant on “Friends: The Reunion.”</p>

              <p>Beyond developing and producing television, he has written a YA novel, voice acted professionally, performed for the American Comedy Institute in Manhattan, and hosts the popular queer podcast “Let’s Talk About That! With Larry Saperstein and Jacob Bellotti.”</p>
            </div>
          </div>

          <div class="about__photos" aria-hidden="false">
            <figure class="scrapbook-photo scrapbook-photo--top">
              <img
                src="/assets/images/jacob-bio.webp"
                alt="Jacob Bellotti in a blue sequined jacket"
                width="1386"
                height="1360"
                loading="lazy"
              >
            </figure>
            <figure class="scrapbook-photo scrapbook-photo--bottom">
              <img
                src="/assets/images/bio-mountains.webp"
                alt="Jacob Bellotti outdoors in a blue windbreaker with mountains in the background"
                width="600"
                height="800"
                loading="lazy"
              >
            </figure>
          </div>
        </div>
      </article>
    </section>

    <section class="site-section" id="work" aria-label="Work">
      <section class="work" aria-labelledby="work-title">
        <h1 class="work__title" id="work-title">Work</h1>
        <div class="work-grid">
          <a class="work-grid__item" href="https://deadline.com/2026/03/mark-rober-kids-science-competition-series-netflix-1236740436/" target="_blank" rel="noopener noreferrer" aria-label="Schooled!">
            <img src="/assets/images/shows/schooled.webp" alt="Poster for Mark Rober’s Schooled! on Netflix" loading="lazy">
          </a>
          <a class="work-grid__item" href="https://youtu.be/4oasYFUcW8M?si=AnJRFhwblWE4zv0s" target="_blank" rel="noopener noreferrer" aria-label="American Gladiators">
            <img src="/assets/images/shows/americangladiators.webp" alt="Poster for American Gladiators on Prime Video" loading="lazy">
          </a>
          <a class="work-grid__item" href="https://youtu.be/b2IK72dKdDk?si=e4SjFYpGRTZbnPXB" target="_blank" rel="noopener noreferrer" aria-label="Slaycation">
            <img src="/assets/images/shows/slaycation.webp" alt="Poster for Slaycation" loading="lazy">
          </a>
          <a class="work-grid__item" href="https://youtu.be/_7vslRXwJZw?si=NeXDD0LoyYJeNXT3" target="_blank" rel="noopener noreferrer" aria-label="RPDR All Stars">
            <img src="/assets/images/shows/rpdras7.webp" alt="Poster for RuPaul’s Drag Race All Stars" loading="lazy">
          </a>
          <a class="work-grid__item" href="https://youtu.be/OfnFU99-uds?si=-Xc4f540LlOMy6gn" target="_blank" rel="noopener noreferrer" aria-label="Owning Manhattan">
            <img src="/assets/images/shows/owningmanhattan.webp" alt="Poster for Owning Manhattan on Netflix" loading="lazy">
          </a>
          <a class="work-grid__item" href="https://youtu.be/i05rVRHc9yE?si=4f-JyBgbrFSoTvmV" target="_blank" rel="noopener noreferrer" aria-label="Drag Race">
            <img src="/assets/images/shows/rpdr15.webp" alt="Poster for RuPaul’s Drag Race" loading="lazy">
          </a>
          <a class="work-grid__item" href="https://youtu.be/UvdAfq8j67w?si=TKzCYEUJiQT3KZ5w" target="_blank" rel="noopener noreferrer" aria-label="Drag Race UK">
            <img src="/assets/images/shows/rpdruk.webp" alt="Poster for RuPaul’s Drag Race UK" loading="lazy">
          </a>
          <a class="work-grid__item" href="https://ew.com/tv/drag-race-symone-gigi-goode-avalon-tv-trailer-spice-world/" target="_blank" rel="noopener noreferrer" aria-label="Avalon TV">
            <img src="/assets/images/shows/avalontv.webp" alt="Poster for Avalon TV" loading="lazy">
          </a>
          <a class="work-grid__item" href="https://youtu.be/qTL_U6mwU4w?si=j6OvGfKFhrMyd6Y4" target="_blank" rel="noopener noreferrer" aria-label="Bring Back My Girls">
            <img src="/assets/images/shows/bringbackmygirls.webp" alt="Poster for Bring Back My Girls" loading="lazy">
          </a>
          <a class="work-grid__item" href="https://www.imdb.com/title/tt29335921/" target="_blank" rel="noopener noreferrer" aria-label="True Crime Story: Citizen Detective">
            <img src="/assets/images/shows/truecrime.webp" alt="Poster for True Crime Story: Citizen Detective" loading="lazy">
          </a>
          <a class="work-grid__item" href="https://www.imdb.com/title/tt26215854/" target="_blank" rel="noopener noreferrer" aria-label="Restaurants at the End of the World">
            <img src="/assets/images/shows/restaurants.webp" alt="Poster for Restaurants at the End of the World" loading="lazy">
          </a>
          <a class="work-grid__item" href="https://www.youtube.com/watch?v=wOIJ4bZmWD8" target="_blank" rel="noopener noreferrer" aria-label="America’s Most Wanted">
            <img src="/assets/images/shows/americawanted.jpeg" alt="Poster for America’s Most Wanted" loading="lazy">
          </a>
        </div>
      </section>
    </section>

    <section class="site-section" id="design" aria-label="Design">
      <section class="design" aria-labelledby="design-title">
        <h1 class="design__title" id="design-title">Design Samples</h1>
        <div class="design-grid">
          <div class="design-grid__row">
            <a
              class="design-grid__item design-grid__item--landscape design-grid__item--ogs"
              href="https://drive.google.com/file/d/1V6XcYaOxsRXtkW-D77PfO6K1lFySrfTX/view"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="OG’s of 90210"

      <h1 class="work__title" id="work-title">Work</h1>
      <div class="work-grid">
        <a class="work-grid__item" href="https://deadline.com/2026/03/mark-rober-kids-science-competition-series-netflix-1236740436/" target="_blank" rel="noopener noreferrer" aria-label="Schooled!">
          <img src="assets/images/shows/schooled.webp" alt="Mark Rober’s Schooled! poster" loading="lazy">
        </a>
        <a class="work-grid__item" href="https://youtu.be/4oasYFUcW8M?si=AnJRFhwblWE4zv0s" target="_blank" rel="noopener noreferrer" aria-label="American Gladiators">
          <img src="assets/images/shows/americangladiators.webp" alt="American Gladiators poster" loading="lazy">
        </a>
        <a class="work-grid__item" href="https://youtu.be/b2IK72dKdDk?si=e4SjFYpGRTZbnPXB" target="_blank" rel="noopener noreferrer" aria-label="Slaycation">
